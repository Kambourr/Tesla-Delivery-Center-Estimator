# Public-data API keys. Copy this file to .env (gitignored). Never commit real values.
# Milestone M0 does not read this file and does not call any API.
#
# Names below are the only keys this example declares: Census, BLS, EIA, and HUD.

# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# HUD User token (Bearer) for the USPS crosswalk and FMR APIs:
# https://www.huduser.gov/portal/dataset/uspszip-api.html
HUD_TOKEN=
